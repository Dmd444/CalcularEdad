<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="250.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dmd.calcularedad.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Fecha de nacimiento" />
      <TextField fx:id="txtFecha" promptText="dd/mm/aaaa" maxWidth="200.0" />
      
      <Button fx:id="btnCalcular" onAction="#calcularEdad" text="Calcular" />
      <Button fx:id="btnLimpiar" onAction="#limpiar" text="Limpiar" />
      
      <Label fx:id="lblResultado" style="-fx-font-style: italic; text=" />
   </children>
</VBox>